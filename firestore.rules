rules_version = '2';

// Canxiol professional portals (psychiatrist / pharmacist).
// Paste into Firebase console → Firestore → Rules → Publish.
//
//   users/{uid}   one profile per account: role, status (approved | rejected) and registration
//                 details. Created by the user at sign-up as "approved" (instant access);
//                 an admin can block an account by setting status to "rejected".
//   admins/{uid}  Leiutis staff who may approve accounts. Add these by hand in the console:
//                 collection "admins", document ID = the staff member's User UID (from Authentication → Users).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Optional text field: may be empty
    function optionalString(v, max) {
      return v is string && v.size() <= max;
    }

    match /users/{uid} {
      // A user sees only their own profile; admins see everyone's
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Sign-up: own document only, a valid role, and status starts as "approved"
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['role', 'status', 'name', 'email', 'workplace', 'registrationNumber', 'consentAt', 'createdAt'])
        && request.resource.data.role in ['psychiatrist', 'pharmacist']
        && request.resource.data.status == 'approved'
        && shortString(request.resource.data.name, 120)
        && shortString(request.resource.data.email, 200)
        && optionalString(request.resource.data.workplace, 160)
        && optionalString(request.resource.data.registrationNumber, 80)
        && request.resource.data.consentAt == request.time
        && request.resource.data.createdAt == request.time;

      // Only admins can change a profile (approve / reject). Users can't promote themselves.
      allow update: if isAdmin()
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /admins/{uid} {
      // Lets the site check "am I an admin?"; nobody can add admins from the site
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
